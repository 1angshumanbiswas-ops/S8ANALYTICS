# Copy to .env.local and fill in once you have real accounts.
# Everything works against emulators/test mode with placeholder values.

# --- Firebase (client, public) ---
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=s8-analytics-31dc5.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=s8-analytics-31dc5
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=s8-analytics-31dc5.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:demoappid

# Set to "true" to point the app at local Firebase emulators (default in dev)
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# --- Firebase Admin (server only, never exposed to client) ---
# Leave blank while using emulators. When you have a real project, generate
# a service account key in Firebase Console > Project Settings > Service Accounts.
FIREBASE_ADMIN_PROJECT_ID=s8-analytics-31dc5
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Razorpay (server only) ---
# Test-mode keys from the Razorpay dashboard (Settings > API Keys > Test Mode).
# Route (marketplace split payments) requires a separate approved account.
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder

# Platform default commission rate (fraction), overridable per-instructor in Firestore
PLATFORM_DEFAULT_COMMISSION_RATE=0.20
